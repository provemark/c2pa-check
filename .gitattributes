# What the release zip leaves out (SPEC-006). tools/build.sh builds from
# `git archive`, which honours export-ignore: everything below stays in the
# repository and never reaches a site.

/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.wp-env.json           export-ignore
/.wp-env.release.json   export-ignore
/.wp-env.test.json      export-ignore
/AI-LOG.md              export-ignore
/NOTES.md               export-ignore
/composer.lock          export-ignore
/docs                   export-ignore
/notes                  export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/phpstan.neon           export-ignore
/phpunit.xml            export-ignore
/pint.json              export-ignore
/specs                  export-ignore
/tests                  export-ignore
/tools                  export-ignore
