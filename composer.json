{
    "name": "provemark/c2pa-check",
    "description": "WordPress plugin that verifies the Content Credentials (C2PA) of uploaded images and shows the result in the Media Library.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Maurice van Loon"
        }
    ],
    "require": {
        "php": "^8.3",
        "provemark/c2pa-verifier": "^0.2.3"
    },
    "autoload": {
        "psr-4": {
            "Provemark\\C2paCheck\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3"
    },
    "scripts": {
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "build": "sh tools/build.sh",
        "test:release": [
            "@build",
            "pest --testsuite=Release"
        ]
    }
}
